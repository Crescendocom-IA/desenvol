# Todas as variáveis são opcionais: sem nenhuma delas o site sobe inteiro e
# funciona. O que muda é o comportamento descrito em cada bloco.
# Copie este arquivo para .env.local e preencha o que já tiver.

# Domínio de produção. Base de canonical, og:url, sitemap.xml e robots.txt.
# Deixe VAZIO em ambientes de preview: sem valor, o site usa a URL do próprio
# deploy da Vercel, e o compartilhamento em redes sociais funciona no preview.
# Sem isso, fora da Vercel: usa https://www.desenvol.com.br
NEXT_PUBLIC_SITE_URL=

# Chave da API do Resend, para o envio real do formulário de contato.
# Sem isso: a server action devolve um mailto: já preenchido com a mensagem.
RESEND_API_KEY=

# Remetente dos e-mails do formulário. Precisa ser um endereço em domínio
# verificado no Resend — não pode ser o mesmo endereço de destino.
# Sem isso: usa o remetente de teste onboarding@resend.dev
RESEND_FROM=
