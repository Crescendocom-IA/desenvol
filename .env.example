# Domínio de produção. Usado em canonical, og:url, sitemap.xml e robots.txt.
# Sem isso, o padrão é https://www.desenvol.com.br.
NEXT_PUBLIC_SITE_URL=https://www.desenvol.com.br

# Envio do formulário de contato.
# Sem estas variáveis o site continua funcionando: a server action devolve um
# mailto já preenchido para o visitante concluir pelo próprio programa de e-mail.
RESEND_API_KEY=
# Remetente verificado no Resend. Precisa ser um domínio validado.
RESEND_FROM="Site Desenvol <contato@desenvol.com.br>"
